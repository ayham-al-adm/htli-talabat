# Production .env template for Admin-Panel-2.2 on albishvps.
#
#   cp deploy/env.production.example .env
#   nano .env                    # fill in every <...>
#   php artisan key:generate     # MUST run -- see APP_KEY below
#   chmod 640 .env && sudo chown user1:www-data .env
#
# Keys are grouped with the reason each value was chosen. The ones marked
# CRITICAL cause silent, hard-to-diagnose breakage if changed carelessly.

APP_NAME="Albish Admin"
APP_ENV=production
# CRITICAL: leave blank and run `php artisan key:generate`. The key that used to
# sit in .env.example is in this repo's git history and must never be reused --
# it encrypts sessions and every Crypt:: value in the database.
APP_KEY=
APP_DEBUG=false
# Anything EXCEPT the exact string "demo". APP_FOR is checked in ~120 places;
# "demo" makes many write endpoints return 403 and swaps LandingSiteSeeder for
# LandingHomeSeeder.
APP_FOR=production

# No trailing slash -- it produces "//" in generated URLs.
# Switch both to https://your.domain once certbot has run.
APP_URL=http://94.252.183.131
ASSET_URL=http://94.252.183.131

# "stack" resolves to the single channel -- one unbounded laravel.log.
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL is a hard requirement: fleetbase/laravel-mysql-spatial, and db_point()
# in app/Helpers/helpers.php emits MySQL 8 ST_GeomFromText with axis-order.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_panel
DB_USERNAME=adminpanel
DB_PASSWORD=<openssl rand -base64 24>

BROADCAST_DRIVER=log

# CRITICAL: never "array". Every rate limiter in RouteServiceProvider (login
# 5/min, 30/min per IP, register, otp, password-update) is cache-backed and
# "array" silently disables all of them. "database" is unavailable -- this repo
# has no cache table migration. Switch to redis only if you add a second app
# server, otherwise per-IP limits become per-server.
CACHE_DRIVER=file

# Leave FILESYSTEM_DRIVER UNSET. ~35 model accessors call env('FILESYSTEM_DRIVER')
# directly (the Laravel 8 name) -- e.g. app/Models/Campaign.php:55. Unset, it
# returns null both with and without config:cache and Storage::disk(null) falls
# through to the default disk. Setting it would make config:cache and the
# uncached path disagree: images work locally, break in production.
FILESYSTEM_DISK=local

# CRITICAL: not "sync". ~30 ShouldQueue classes -- ride dispatch, FCM pushes,
# invoice PDFs, ~17 mail jobs -- would otherwise run inline in the HTTP request.
# Needs the systemd worker from deploy/systemd/.
QUEUE_CONNECTION=database

SESSION_DRIVER=file
# Was hard-coded to 1051200 minutes (730 days). 480 = an 8-hour working day.
SESSION_LIFETIME=480

#--------------------------------------------------------------------------
# CRITICAL -- required while serving over plain HTTP
#--------------------------------------------------------------------------
# config/session.php defaults `secure` to (APP_ENV !== 'local'), so on
# APP_ENV=production the session, remember-me and XSRF cookies become
# Secure-only. Over HTTP the browser accepts them and never sends them back:
# login appears to succeed and bounces straight back to the login page.
#
# DELETE THIS LINE the moment TLS is live -- it then reverts to true on its own.
SESSION_SECURE_COOKIE=false

# Not "strict": routes/web.php has ~18 payment-gateway return routes (paypal,
# stripe, razorpay, ccavenue, sadad...). Strict drops the cookie on the
# cross-site navigation back, so customers look logged out right after paying.
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false
# Set SESSION_DOMAIN only once you have a real domain (a bare IP is invalid here).
# SESSION_DOMAIN=panel.example.com

# config/sanctum.php otherwise defaults to localhost/127.0.0.1 and stateful
# SPA auth breaks. Change to the domain when DNS is live.
SANCTUM_STATEFUL_DOMAINS=94.252.183.131

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp pass>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<noreply@your.domain>
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MTN SMS -- the values previously in .env.example are in git history; rotate at
# the provider and paste the new ones here.
MTN_SMS_USER=
MTN_SMS_PASS=
MTN_SMS_FROM=
MTN_SMS_LANG=1

# Read by app/Jobs/Notifications/FcmPushNotification.php
FCM_SERVER_KEY=

#--------------------------------------------------------------------------
# Authentication security (config/security.php) -- defaults are sensible
#--------------------------------------------------------------------------
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=1
SECURITY_LOGIN_IP_MAX_ATTEMPTS=30
SECURITY_REGISTER_MAX_ATTEMPTS=5
SECURITY_REGISTER_DECAY_MINUTES=60
SECURITY_OTP_MAX_ATTEMPTS=5
SECURITY_OTP_DECAY_MINUTES=10
SECURITY_PASSWORD_MAX_ATTEMPTS=5
SECURITY_PASSWORD_DECAY_MINUTES=60

# Lockout counters live on the users table, so they survive a cache flush.
# Escape hatch: php artisan auth:unlock <email|mobile|username>
SECURITY_LOCKOUT_ENABLED=true
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MINUTES=15
SECURITY_LOCKOUT_WINDOW_MINUTES=15

SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_MAX_LENGTH=72
SECURITY_PASSWORD_MIXED_CASE=true
SECURITY_PASSWORD_NUMBERS=true
SECURITY_PASSWORD_SYMBOLS=true
# Turning this on requires outbound HTTPS to api.pwnedpasswords.com on every
# password change.
SECURITY_PASSWORD_UNCOMPROMISED=false

# Note the misspelling -- it is consistent across config/services.php and
# config/security.php, so match it exactly.
ENABLE_RECAPTCHA=false
REACPTCHA_SITE_KEY=
REACPTCHA_SECRET_KEY=
SECURITY_CAPTCHA_WEB=true
# Leave false until the mobile apps actually send a captcha token, or every
# app login 403s.
SECURITY_CAPTCHA_API=false
SECURITY_CAPTCHA_MIN_SCORE=0.5

#--------------------------------------------------------------------------
# Security headers (app/Http/Middleware/SecurityHeaders.php)
#--------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_COOP=same-origin-allow-popups

# HSTS is only emitted on HTTPS requests, so it stays inert until certbot runs
# and then activates by itself. Leave preload off -- it is irreversible.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

# Ships as Content-Security-Policy-Report-Only while ENFORCE=false. Keep it
# report-only for at least a week after go-live, watch the browser console for
# violations from the payment-gateway/Maps/Firebase CDNs, then flip to true.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_ENFORCE=false
SECURITY_CSP_REPORT_URI=
