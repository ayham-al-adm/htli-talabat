APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_FOR=demo1

APP_URL=http://127.0.0.1:8000
ASSET_URL=http://127.0.0.1:8000


LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


VITE_APP_NAME="${APP_NAME}"

# MTN SMS Service Configuration
MTN_SMS_USER=
MTN_SMS_PASS=
MTN_SMS_FROM=
MTN_SMS_LANG=1

# Firebase Cloud Messaging -- read by app/Jobs/Notifications/FcmPushNotification.php
FCM_SERVER_KEY=

#--------------------------------------------------------------------------
# Authentication security (config/security.php)
#--------------------------------------------------------------------------
# Rate limiting and lockout counters are cache backed. CACHE_DRIVER must NOT be
# "array" -- that driver forgets everything between requests, which silently
# disables every throttle below.

# Login throttling: attempts per credential+IP, and a wider per-IP cap.
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=1
SECURITY_LOGIN_IP_MAX_ATTEMPTS=30

# Signup throttling.
SECURITY_REGISTER_MAX_ATTEMPTS=5
SECURITY_REGISTER_DECAY_MINUTES=60

# OTP send/verify throttling.
SECURITY_OTP_MAX_ATTEMPTS=5
SECURITY_OTP_DECAY_MINUTES=10

# Password reset / update throttling.
SECURITY_PASSWORD_MAX_ATTEMPTS=5
SECURITY_PASSWORD_DECAY_MINUTES=60

# Account lockout after repeated failed credential checks (stored on users table).
SECURITY_LOCKOUT_ENABLED=true
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MINUTES=15
SECURITY_LOCKOUT_WINDOW_MINUTES=15

# Password policy.
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_MAX_LENGTH=72
SECURITY_PASSWORD_MIXED_CASE=true
SECURITY_PASSWORD_NUMBERS=true
SECURITY_PASSWORD_SYMBOLS=true
SECURITY_PASSWORD_UNCOMPROMISED=false

# CAPTCHA on the auth routes. Keys are shared with Admin > reCAPTCHA.
# Leave SECURITY_CAPTCHA_API=false until the mobile apps send a captcha token,
# otherwise every app login is rejected.
ENABLE_RECAPTCHA=false
REACPTCHA_SITE_KEY=
REACPTCHA_SECRET_KEY=
SECURITY_CAPTCHA_WEB=true
SECURITY_CAPTCHA_API=false
SECURITY_CAPTCHA_MIN_SCORE=0.5

#--------------------------------------------------------------------------
# HTTP security headers (config/security.php > headers)
#--------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_COOP=same-origin-allow-popups

# HSTS is only ever sent over HTTPS. Do not turn on preload until every
# subdomain serves HTTPS permanently -- removal takes months.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

# Content-Security-Policy.
# With SECURITY_CSP_ENFORCE=false (the default) the safe baseline is enforced
# and the full policy is sent as Content-Security-Policy-Report-Only, so
# violations appear in the browser console without breaking anything. Watch it
# for a week, fix what shows up, then set this to true.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_ENFORCE=false
SECURITY_CSP_REPORT_URI=

# Permissions-Policy. Leave unset to use the audited default in
# config/security.php -- note geolocation is scoped to (self) rather than
# disabled, because Open Dispatch and customer booking both need it.
# SECURITY_PERMISSIONS_POLICY=

#--------------------------------------------------------------------------
# Session and cookie hardening (config/session.php)
#--------------------------------------------------------------------------
# SESSION_LIFETIME is idle minutes. config/session.php previously hard-coded
# 1051200 (730 days) and ignored this value; it now honours it. 120 = 2 hours.
# SESSION_LIFETIME=120

# Secure flag on the session, "remember me" and XSRF-TOKEN cookies. Defaults to
# ON unless APP_ENV=local, so a plain-HTTP XAMPP install still works. Set this
# to true explicitly if you run APP_ENV=local behind HTTPS.
# SESSION_SECURE_COOKIE=true

# Leave HttpOnly on. Only the XSRF-TOKEN cookie is readable by JS (by design,
# axios needs it); the session cookie never is.
# SESSION_HTTP_ONLY=true

# lax | strict | none.
# "strict" is NOT the default: the browser drops the cookie on cross-site
# navigations INTO the site, and routes/web.php has ~18 payment-gateway return
# routes the customer is redirected back through. Under strict they land there
# with no session and appear logged out right after paying. Switch to strict
# only if you stop using hosted gateway redirects.
# SESSION_SAME_SITE=lax

# End the session when the browser closes, on top of the idle lifetime.
# SESSION_EXPIRE_ON_CLOSE=false
